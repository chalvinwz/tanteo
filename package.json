{
  "name": "tanteo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "dev": "pnpm -r --parallel dev",
    "start:local": "TANTEO_DB=:memory: TANTEO_WEB_ROOT=./apps/web/dist node apps/server/dist/main.js",
    "e2e": "pnpm --filter @tanteo/e2e e2e",
    "lighthouse": "lhci autorun"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "typescript": "^5.9.2"
  }
}
